{
	"name": "talk-autoshare/talk_autoshare",
	"description": "Auto-share Nextcloud Talk call recordings into the conversation chat",
	"type": "project",
	"license": "AGPL-3.0-or-later",
	"autoload": {
		"psr-4": {
			"OCA\\TalkAutoShare\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\TalkAutoShare\\Tests\\": "tests/",
			"OCP\\": "vendor/nextcloud/ocp/OCP/"
		}
	},
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"nextcloud/ocp": "dev-stable34"
	},
	"scripts": {
		"test": "phpunit -c tests/phpunit.xml",
		"lint": "find lib tests -name '*.php' -print0 | xargs -0 -n1 php -l"
	},
	"config": {
		"platform": {
			"php": "8.2"
		},
		"sort-packages": true
	}
}
